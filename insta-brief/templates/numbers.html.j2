{% extends "base.html.j2" %}
{% block body %}
  <div class="numbers">
    <h1 class="title">Today in <span class="acc">numbers</span></h1>
    <ol class="stats">
      {% for s in stats %}
      <li><span class="num">{{ s.stat }}</span><span class="lbl">{{ s.stat_label or s.headline }}</span></li>
      {% endfor %}
    </ol>
    <div class="save-cue">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"><path d="M6 3h12v18l-6-4.5L6 21z"/></svg>
      <span>Save for later</span>
      <span class="handle">{{ brand.handle }}</span>
    </div>
  </div>
{% endblock %}
