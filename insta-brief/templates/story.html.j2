{% extends "base.html.j2" %}
{% block body %}
  <h2 class="headline">{{ story.hl_before }}<span class="hl">{{ story.hl_text }}</span>{{ story.hl_after }}</h2>
  <div class="figure-wrap">
    <div class="ph">
      {% if story.image_file %}<img src="{{ story.image_file }}" style="object-position: {{ story.image_position or 'center 30%' }}">
      {% else %}<div class="fallback"><div class="fb-word">{{ story.fallback_word }}</div></div>{% endif %}
      {% if story.category %}<div class="chip">{{ story.category }}</div>{% endif %}
      <div class="badge">#{{ story.rank }}</div>
    </div>
    {% if story.credit %}<div class="credit">{{ story.credit }}</div>{% endif %}
  </div>
  <p class="summary">{{ story.summary }}</p>
  {% if story.why_it_matters %}<p class="why"><span class="label">Why it matters</span>{{ story.why_it_matters }}</p>{% else %}<div style="height:22px"></div>{% endif %}
{% endblock %}
{% block swipe %}{{ 'Swipe for quick hits' if last else 'Swipe for the next' }}{% endblock %}
